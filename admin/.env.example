# Admin panel environment variables
# Copy relevant section to your local .env or deployment config.
# Never commit secrets or real credentials to this file.

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

# Dev-only shortcut: bypasses OTP login in the browser by pre-setting a role.
# The backend still enforces RBAC on every request — this only affects frontend
# navigation and the session role display.
# REQUIRED: set to "false" or remove entirely for production builds.
VITE_ENABLE_ADMIN_DEV_AUTH=true
VITE_ADMIN_DEV_ROLE=SUPER_ADMIN   # SUPER_ADMIN | ADMIN | SUPPORT | FINANCE | AUDITOR

# ---------------------------------------------------------------------------
# PRODUCTION (set these as Vercel Environment Variables — never in this file)
# ---------------------------------------------------------------------------
# VITE_API_BASE_URL=https://fondixpay-production.up.railway.app
# VITE_ENABLE_ADMIN_DEV_AUTH=false
# Do NOT set VITE_ADMIN_DEV_ROLE in production.
