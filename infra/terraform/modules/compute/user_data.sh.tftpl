#!/bin/bash
set -euo pipefail

dnf update -y
dnf install -y docker git amazon-cloudwatch-agent
systemctl enable --now docker

mkdir -p /opt/fondixpay
cat >/opt/fondixpay/README.txt <<'EOF'
FondixPay backend dev host.

Environment: ${environment}
Backend port: ${backend_port}

This host is provisioned for mock/dev validation only.
Do not store production secrets or run real payment/provider traffic here.
EOF

cat >/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'EOF'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/cloud-init-output",
            "timezone": "UTC"
          }
        ]
      }
    }
  }
}
EOF

/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config \
  -m ec2 \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json \
  -s

