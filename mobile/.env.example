# FondixPay Mobile — Environment Variables
# Copy to .env and fill in values. Never commit .env with real credentials.

# ---------------------------------------------------------------------------
# PRODUCTION
# ---------------------------------------------------------------------------
# EXPO_PUBLIC_API_URL=https://fondixpay-production.up.railway.app

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT
# ---------------------------------------------------------------------------
# Emulador Android (suele funcionar sin .env — usa 10.0.2.2:8000 automáticamente)
# iOS Simulator:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
# Dispositivo físico — usa la IP de tu PC en la red local:
# EXPO_PUBLIC_API_URL=http://192.168.1.x:8000
EXPO_PUBLIC_API_URL=
