# Copia a .env y ajusta si hace falta.
# En dispositivo físico con Expo Go, usa la IP de tu PC en la red local (la misma que muestra Metro).
# Ejemplo: EXPO_PUBLIC_API_URL=http://192.168.1.136:8000
#
# Emulador Android: suele bastar sin .env (usa 10.0.2.2:8000).
# iOS simulator: http://127.0.0.1:8000
EXPO_PUBLIC_API_URL=
