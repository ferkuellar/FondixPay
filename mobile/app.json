{
  "expo": {
    "name": "FONDIX PAY",
    "slug": "fondix-pay",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fondixpay",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E5FE8"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Podemos usar tu ubicación para sugerir tu estado. También puedes elegirlo manualmente."
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://127.0.0.1:8000"
    },

    "expo": {
      "newArchEnabled": true
    }
  }
}


