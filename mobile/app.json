{
  "expo": {
    "name": "FONDIX PAY",
    "slug": "fondix-pay",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fondixpay",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fondixpay.app"
    },
    "android": {
      "package": "com.fondixpay.app",
      "adaptiveIcon": {
        "backgroundColor": "#1E5FE8"
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Podemos usar tu ubicación para sugerir tu estado. También puedes elegirlo manualmente."
        }
      ]
    ]
  }
}
