# Backend
DATABASE_URL=postgresql+psycopg://fondix:fondix@localhost:5432/fondix_pay

# Development-only example values. Do not use this file as production configuration.
APP_ENV=development
JWT_SECRET_KEY=change-me-in-local-env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_DEV_CODE=123456
OTP_DEV_RESPONSE_ENABLED=true
CORS_ORIGINS=   http://localhost:19006,
                http://localhost:3000,
                http://localhost:8081,
                http://127.0.0.1:8081
FONDIX_FEE_MINOR=750

# Provider sandbox placeholders. Keep real credentials in environment-specific secret storage.
CARD_PROCESSOR_PROVIDER=mock
CARD_PROCESSOR_ENV=sandbox
CARD_PROCESSOR_API_BASE_URL=
CARD_PROCESSOR_PUBLIC_KEY=
CARD_PROCESSOR_SECRET_KEY=
CARD_PROCESSOR_WEBHOOK_SECRET=
CARD_PROCESSOR_TIMEOUT_SECONDS=15

PRONTIPAGOS_ENV=sandbox
PRONTIPAGOS_API_BASE_URL=
PRONTIPAGOS_CLIENT_ID=
PRONTIPAGOS_CLIENT_SECRET=
PRONTIPAGOS_TIMEOUT_SECONDS=15
PRONTIPAGOS_ENABLE_SANDBOX_MOCK=true

# WhatsApp receipt MVP. Mock/disabled by default; never commit real provider secrets.
WHATSAPP_PROVIDER=mock
WHATSAPP_ENV=sandbox
WHATSAPP_ENABLE_RECEIPT_MVP=false
WHATSAPP_TEMPLATE_PAYMENT_SUCCESS=fondix_pago_exitoso
WHATSAPP_PROVIDER_API_BASE_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_TIMEOUT_SECONDS=10

# Public landing chatbot. AI provider is optional; empty values keep FAQ/rule-only mode.
CHATBOT_AI_PROVIDER=
CHATBOT_AI_API_KEY=
CHATBOT_AI_MODEL=
CHATBOT_MAX_MESSAGE_LENGTH=500

# Staging/production rules:
# - JWT_SECRET_KEY must be a strong private value.
# - OTP_DEV_RESPONSE_ENABLED must be false.
# - CORS_ORIGINS must be explicit and must not use "*".
# - FONDIX_FEE_MINOR is a mock/dev example until the commercial fee model is approved.

# Docker Postgres
POSTGRES_DB=fondix_pay
POSTGRES_USER=fondix
POSTGRES_PASSWORD=fondix

# Mobile (opcional; Expo Go en LAN suele autodetectar la IP de Metro)
# EXPO_PUBLIC_API_URL=http://192.168.1.136:8000
