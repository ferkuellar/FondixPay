# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fondix_pay_dev.db

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-use-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Environment ───────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development (default):
# CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:4173,http://localhost:5200
# Production (set this in Railway environment variables):
# CORS_ORIGINS=https://fondixpay.com,https://www.fondixpay.com,https://fondixpay.com.mx,https://www.fondixpay.com.mx,https://crm.fondixpay.com,https://fondixpay-crm.vercel.app

# ── Chatbot AI ────────────────────────────────────────────────────────────────
CHATBOT_AI_API_KEY=sk-ant-api03-...
CHATBOT_AI_MODEL=claude-haiku-4-5-20251001
# Leave CHATBOT_AI_API_KEY empty to run without AI (bot falls back to FAQ/rules only)

# ── OTP (dev only) ────────────────────────────────────────────────────────────
OTP_DEV_RESPONSE_ENABLED=true
OTP_DEV_CODE=123456
# Set OTP_DEV_RESPONSE_ENABLED=false in production

# ── Card processor (mock only until real provider is contracted) ───────────────
CARD_PROCESSOR_PROVIDER=mock
CARD_PROCESSOR_ENV=sandbox
# CARD_PROCESSOR_API_BASE_URL=
# CARD_PROCESSOR_PUBLIC_KEY=
# CARD_PROCESSOR_SECRET_KEY=
