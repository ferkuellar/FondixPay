# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fondix_pay_dev.db

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-use-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Environment ───────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development (default):
# CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:4173,http://localhost:5200
# Production (set this in Railway environment variables):
# CORS_ORIGINS=https://fondixpay.com,https://www.fondixpay.com,https://fondixpay.com.mx,https://www.fondixpay.com.mx,https://crm.fondixpay.com,https://fondixpay-crm.vercel.app

# ── Chatbot AI ────────────────────────────────────────────────────────────────
CHATBOT_AI_API_KEY=sk-ant-api03-...
CHATBOT_AI_MODEL=claude-haiku-4-5-20251001
# Leave CHATBOT_AI_API_KEY empty to run without AI (bot falls back to FAQ/rules only)

# ── OTP (dev only) ────────────────────────────────────────────────────────────
OTP_DEV_RESPONSE_ENABLED=true
OTP_DEV_CODE=123456
# Set OTP_DEV_RESPONSE_ENABLED=false in production

# ── Card processor (mock only until real provider is contracted) ───────────────
CARD_PROCESSOR_PROVIDER=mock
CARD_PROCESSOR_ENV=sandbox
# CARD_PROCESSOR_API_BASE_URL=
# CARD_PROCESSOR_PUBLIC_KEY=
# CARD_PROCESSOR_SECRET_KEY=

# ── Resend (formulario de contacto landing) ───────────────────────────────────
RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=contacto@fondixpay.com
# RESEND_TO_EMAIL=fernando.cuellar@fondixpay.com

# ── SMS / OTP (producción) ─────────────────────────────────────────────────────
# SMS_PROVIDER=twilio        # "mock" (dev) | "twilio" (producción)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx   # número Twilio con capacidad SMS
# TWILIO_TIMEOUT_SECONDS=10

# ── Tekae SSO ─────────────────────────────────────────────────────────────────
# Tekae es el proveedor de pagos/servicios de FondixPay (modelo SSO responsivo).
# Contrato de API confirmado en Sprint 011 (2026-06-16) — sandbox verificado end-to-end.
#
# Flujo de tokens (backend únicamente):
#   1. POST {TEKAE_BASE_URL}/tokens/cipherData  → { data, uid }
#   2. POST {TEKAE_BASE_URL}/tokens/generateTokenCiphered  → { accessToken, refreshToken }
#   3. URL portal: {TEKAE_RESPONSIVE_BASE_URL}/user/{TEKAE_PORTAL_UID}/token/{accessToken}
#
# Nota: TEKAE_UID (cuerpo de la solicitud API) ≠ TEKAE_PORTAL_UID (en la URL del portal).
#       Son dos identificadores distintos proporcionados por Tekae.
#
# DEV:     TEKAE_ENABLED=false (mock/demo solamente — sin llamadas a Tekae)
# STAGING: TEKAE_ENABLED=true solo con credenciales sandbox; pendiente Sprint 086
# PROD:    TEKAE_ENABLED=true solo con credenciales productivas, VPN/VPC, y aprobación de seguridad
#
# El backend es el ÚNICO componente autorizado a generar tokens Tekae.
# Mobile, admin, landing y frontend NUNCA reciben TEKAE_BEARER, TEKAE_UID,
# TEKAE_PASSWORD, TEKAE_PORTAL_UID ni accessToken crudos.
#
TEKAE_ENABLED=false
# Sandbox: https://endpointtekaetoken-917994269107.us-central1.run.app
# Prod:    https://endpointtekaetokenprod-704030137706.us-central1.run.app
TEKAE_BASE_URL=
# Sandbox: https://responsive-dot-tekae-des-gtec.ue.r.appspot.com/responsive
# Prod:    https://tekae.com.mx/responsive
TEKAE_RESPONSIVE_BASE_URL=
# Bearer token para el header Authorization: Bearer {TEKAE_BEARER} — secreto
TEKAE_BEARER=
# UID de la empresa para el cuerpo de /tokens/cipherData y /tokens/generateTokenCiphered — secreto
TEKAE_UID=
# Contraseña KMS-encriptada provista por Tekae para el cuerpo de /tokens/cipherData — secreto
TEKAE_PASSWORD=
# UID de empresa para la URL del portal: .../user/{TEKAE_PORTAL_UID}/token/... — secreto
TEKAE_PORTAL_UID=
TEKAE_TIMEOUT_SECONDS=10
# TEKAE_REQUIRE_PRIVATE_NETWORK=true bloquea generación de token en producción sin VPN/VPC aprobada
TEKAE_REQUIRE_PRIVATE_NETWORK=true
