# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./fondix_pay_dev.db

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-use-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Environment ───────────────────────────────────────────────────────────────
APP_ENV=development
# Options: development | staging | production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Development (default):
# CORS_ORIGINS=http://localhost:19006,http://localhost:8081,http://localhost:4173,http://localhost:5200
# Production (set this in Railway environment variables):
# CORS_ORIGINS=https://fondixpay.com,https://www.fondixpay.com,https://fondixpay.com.mx,https://www.fondixpay.com.mx,https://crm.fondixpay.com,https://fondixpay-crm.vercel.app

# ── Chatbot AI ────────────────────────────────────────────────────────────────
CHATBOT_AI_API_KEY=sk-ant-api03-...
CHATBOT_AI_MODEL=claude-haiku-4-5-20251001
# Leave CHATBOT_AI_API_KEY empty to run without AI (bot falls back to FAQ/rules only)

# ── OTP (dev only) ────────────────────────────────────────────────────────────
OTP_DEV_RESPONSE_ENABLED=true
OTP_DEV_CODE=123456
# Set OTP_DEV_RESPONSE_ENABLED=false in production

# ── Card processor (mock only until real provider is contracted) ───────────────
CARD_PROCESSOR_PROVIDER=mock
CARD_PROCESSOR_ENV=sandbox
# CARD_PROCESSOR_API_BASE_URL=
# CARD_PROCESSOR_PUBLIC_KEY=
# CARD_PROCESSOR_SECRET_KEY=

# ── Resend (formulario de contacto landing) ───────────────────────────────────
RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=contacto@fondixpay.com
# RESEND_TO_EMAIL=fernando.cuellar@fondixpay.com

# ── SMS / OTP (producción) ─────────────────────────────────────────────────────
# SMS_PROVIDER=twilio        # "mock" (dev) | "twilio" (producción)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx   # número Twilio con capacidad SMS
# TWILIO_TIMEOUT_SECONDS=10

# ── Tekae SSO ─────────────────────────────────────────────────────────────────
# Tekae es el proveedor de pagos/servicios de FondixPay (modelo SSO responsivo).
# TEKAE_ENABLED debe permanecer false hasta que:
#   1. Se reciban sandbox URL, Swagger y credenciales de prueba de Tekae.
#   2. El sprint de implementación sea aprobado con criterios de aceptación.
#   3. Exista configuración de red privada (VPN/VPC) aprobada para producción.
#
# DEV:     TEKAE_ENABLED=false (mock/demo solamente — sin llamadas a Tekae)
# STAGING: TEKAE_ENABLED=false hasta recibir sandbox credentials
# PROD:    TEKAE_ENABLED=true solo con credentials productivas, VPN/VPC, y aprobación de seguridad
#
# El backend es el único componente autorizado a generar tokens Tekae.
# Mobile, admin, landing y frontend NO deben recibir TEKAE_UID, TEKAE_PASSWORD ni accessToken crudos.
#
TEKAE_ENABLED=false
TEKAE_BASE_URL=
TEKAE_RESPONSIVE_BASE_URL=https://tekae.com.mx/responsive
TEKAE_UID=
TEKAE_PASSWORD=
TEKAE_TIMEOUT_SECONDS=10
# TEKAE_REQUIRE_PRIVATE_NETWORK=true bloquea generación de token en producción sin VPN/VPC aprobada
TEKAE_REQUIRE_PRIVATE_NETWORK=true
